pipeline {
    agent any

    stages {
        stage('Test 1 - Basic') {
            steps {
                echo 'Pipeline is finally running!'
                echo "Current time: ${new Date()}"
            }
        }

        stage('Test 2 - Windows command') {
            steps {
                bat 'echo Hello from Windows'
                bat 'ver'           // shows Windows version
                bat 'docker version || echo Docker not working or not found'
            }
        }
    }
}
