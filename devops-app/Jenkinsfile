pipeline {
    agent any

    tools {
        nodejs 'NodeJS'   // Make sure NodeJS is configured in Jenkins Global Tools
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ramya-harshinivs26/devops-main-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('devops-app') {
                    bat 'npm install'
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('devops-app') {
                    bat 'npm start'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline executed successfully!'
        }
        failure {
            echo '❌ Pipeline failed. Check logs.'
        }
    }
}
