pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git 'https://github.com/ramya-harshinivs26/devops-main-project.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ramyavs/docker-node-app:latest .'
            }
        }

        stage('Push Docker Image') {
            steps {
                sh 'docker push ramyavs/docker-node-app:latest'
            }
        }
    }
}
