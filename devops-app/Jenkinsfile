pipeline {
    agent any

    environment {
        DOCKER_USER   = 'ramyavs'                  // your Docker Hub username
        APP_NAME      = 'docker-node-app'          // change to your actual app name
        IMAGE_NAME    = "${DOCKER_USER}/${APP_NAME}"
        IMAGE_TAG     = "${env.BUILD_NUMBER}"      // unique per build, or use 'latest'
    }

    stages {
        stage('Build Docker Image') {
            steps {
                // Build using the correct Dockerfile path and context (devops-app folder)
                bat "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f devops-app/Dockerfile devops-app"
                
                // Optional: also tag as latest
                bat "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest"
            }
        }

        stage('Login & Push to Docker Hub') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds', 
                    usernameVariable: 'DOCKER_USER_VAR', 
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    bat '''
                    echo %DOCKER_PASS% | docker login -u %DOCKER_USER_VAR% --password-stdin
                    docker push %IMAGE_NAME%:%IMAGE_TAG%
                    docker push %IMAGE_NAME%:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            bat 'docker logout || exit 0'
            // Optional cleanup - remove local images to save disk space
            bat "docker rmi %IMAGE_NAME%:%IMAGE_TAG% || exit 0"
            bat "docker rmi %IMAGE_NAME%:latest || exit 0"
        }
    }
}
